# ============================================================
# Speed-ZeroBaran — Environment Variables (Template)
# Copy this file to `.env` and fill in your free-tier keys.
# Author: Baran Avisat <Baranavisat@gmail.com>
# ============================================================

# ---------- Target Sites (comma separated) ----------
TARGET_SITES=https://example.com,https://your-shop.com

# ---------- Google PageSpeed Insights API (FREE) ----------
# Get it from: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# ---------- Google Gemini API (FREE tier) ----------
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---------- Groq API (FREE tier — fallback AI) ----------
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# ---------- Supabase (FREE tier PostgreSQL) ----------
# Get it from: https://supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_TABLE=speed_audit_logs

# ---------- Telegram Bot (FREE) ----------
# Create a bot via @BotFather, then chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---------- Audit Settings ----------
# Threshold (seconds) below which we send alert
SPEED_ALERT_THRESHOLD=2.5
# Performance score threshold (0-100)
SCORE_ALERT_THRESHOLD=70
# Strategy: mobile | desktop
AUDIT_STRATEGY=mobile
# AI provider: gemini | groq
AI_PROVIDER=gemini
# Run frequency in GitHub Actions cron: every 6 hours
CRON_SCHEDULE="0 */6 * * *"
